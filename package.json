{
  "name": "opencode-gemini-rotator",
  "version": "1.0.4",
  "description": "OpenCode plugin for multiple Gemini API keys rotation",
  "main": "dist/index.js",
  "tui": "dist/tui.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && bun build.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "gemini",
    "rotator",
    "api-key"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "@opencode-ai/sdk": "^1.4.3"
  },
  "devDependencies": {
    "@opentui/core": "^0.1.99",
    "@opentui/solid": "^0.1.99",
    "@types/node": "^20.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
